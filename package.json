{
  "name": "@musnows/scriverse-app",
  "version": "0.0.1",
  "description": "Scriverse Android cloud workspace client",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-web.mjs",
    "cap:sync": "npm run build && npx cap sync android",
